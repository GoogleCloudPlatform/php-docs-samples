# Use the official PHP 8.3 Apache image for App Engine Flexible custom runtimes.
# https://hub.docker.com/_/php
FROM php:8.3-apache

COPY --from=composer:latest-bin /composer /usr/local/bin/composer

WORKDIR /var/www/html
COPY . .

RUN apt-get update && apt-get -y install unzip && \
    composer install --no-dev && \
    sed -i 's/80/8080/g' /etc/apache2/sites-available/000-default.conf /etc/apache2/ports.conf
